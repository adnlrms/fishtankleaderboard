    },
    fail: function(err){
      inp.removeAttribute('data-pending');
      st.textContent = '⚠'; st.title = errText(err);
      inp.value = cur === null ? '' : cur;
      handleTeacherError(err);
    }
  });
  return true;
}

/* Scores typed quickly are sent together in one request, one request at a time. */
var saveQ = [], saving = false;
function queueSave(item){ saveQ.push(item); pumpSaves(); }
function pumpSaves(){
  if (saving || !saveQ.length) return;
  var head = saveQ[0];
  var batch = saveQ.filter(function(x){ return x.pin === head.pin && x.section === head.section; });
  saveQ = saveQ.filter(function(x){ return batch.indexOf(x) < 0; });
  saving = true;
  api('saveScores', head.pin, head.section, batch.map(function(b){ return { name:b.name, exam:b.exam, value:b.value }; }))
    .then(function(res){
      saving = false;
      batch.forEach(function(b, i){
        var r = res && res[i];
        if (r && r.ok) b.ok(); else b.fail(new Error((r && r.error) || 'Not saved.'));
      });
      pumpSaves();
    })
    .catch(function(err){
      saving = false;
      if (isAuthErr(err)){ batch.concat(saveQ).forEach(function(b){ b.fail(err); }); saveQ = []; return; }
      batch.forEach(function(b){ b.fail(err); });
      pumpSaves();
    });
}
window.addEventListener('beforeunload', function(e){
  if (saving || saveQ.length){ e.preventDefault(); e.returnValue = 'Some scores are still saving.'; return e.returnValue; }
});

