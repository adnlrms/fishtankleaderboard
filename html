  if (fd.kind === 'rotten'){
    c.fillStyle = '#6f7a2c'; c.beginPath(); c.arc(0, 0, 8*s, 0, 7); c.arc(6*s, -3*s, 5*s, 0, 7); c.arc(-5*s, 3*s, 5*s, 0, 7); c.fill();
    c.fillStyle = '#4a5220'; [[-3,-2],[3,2],[6,-4]].forEach(function(p){ c.beginPath(); c.arc(p[0]*s, p[1]*s, 1.6*s, 0, 7); c.fill(); });
    c.strokeStyle = 'rgba(190,230,120,.75)'; c.lineWidth = 1.5*s;
