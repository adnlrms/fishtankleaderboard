  else if (k === 'f') toggleFS();
  else if ((k === 'arrowleft' || k === 'arrowright') && DATA){
    viewExam = clamp(viewExam + (k === 'arrowright' ? 1 : -1), -1, DATA.lastExam);
    followLatest = viewExam === DATA.lastExam; $('exam').value = viewExam; recompute();
  }
});
