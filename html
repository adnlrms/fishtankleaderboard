<!DOCTYPE html>
<html lang="en">
<head>
<base target="_top">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Class Aquarium</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --panel:rgba(5,28,54,.84);
  --panel2:rgba(255,255,255,.07);
  --line:rgba(160,215,255,.18);
  --text:#ecf7ff;
  --muted:#93bfdf;
  --gold:#ffd34d;
  --good:#4fe0c0;
  --warn:#ffb35c;
  --bad:#ff6b6b;
  --sick:#b6e07a;
}
*{box-sizing:border-box}
html,body{margin:0;height:100%;background:#021428;color:var(--text);font-family:'Fredoka',system-ui,-apple-system,'Segoe UI',sans-serif;overflow:hidden}
#app{display:flex;height:100vh;width:100vw}
#tankWrap{position:relative;flex:1;min-width:0;overflow:hidden}
#tank{display:block;width:100%;height:100%}
#topbar{position:absolute;top:14px;left:16px;right:16px;display:flex;gap:10px;align-items:center;flex-wrap:wrap;pointer-events:none;z-index:2}
#topbar>*{pointer-events:auto}
#title{font-size:clamp(22px,2.4vw,38px);font-weight:700;letter-spacing:.3px;margin-right:auto;text-shadow:0 3px 12px rgba(0,0,0,.55);pointer-events:none;line-height:1.1}
#title small{display:block;font-size:.42em;font-weight:500;color:var(--muted);letter-spacing:0;margin-top:2px}
.pill{display:flex;align-items:center;gap:8px;background:var(--panel);border:1px solid var(--line);border-radius:999px;padding:7px 14px;font-size:15px;backdrop-filter:blur(8px)}
button{font:inherit;font-size:15px;color:var(--text);background:var(--panel);border:1px solid var(--line);border-radius:999px;padding:7px 14px;cursor:pointer;backdrop-filter:blur(8px);transition:background .15s,border-color .15s}
button:hover{background:rgba(25,75,125,.92)}
button.on{border-color:var(--gold);color:var(--gold)}
button.primary{background:var(--gold);color:#3a2a00;border-color:var(--gold);font-weight:600}
button.primary:hover{background:#ffe07a}
button:disabled{opacity:.5;cursor:default}
select,input[type=text],input[type=password],input[type=number],textarea{font:inherit;color:var(--text);background:rgba(0,0,0,.28);border:1px solid var(--line);border-radius:10px;padding:7px 10px;outline:none}
select:focus,input:focus,textarea:focus{border-color:var(--gold)}
select option{background:#06264a}
#sectionSel{border:none;background:transparent;padding:0 4px;font-size:15px;max-width:220px}
input[type=range]{accent-color:var(--gold);width:clamp(110px,14vw,200px);cursor:pointer}
#examLabel{min-width:96px;font-weight:600;white-space:nowrap}
#bottombar{position:absolute;left:16px;right:16px;bottom:14px;z-index:2;display:flex;gap:10px;flex-wrap:wrap;pointer-events:none}
#bottombar .pill{font-size:14px}
.bar{width:120px;height:8px;border-radius:99px;background:rgba(255,255,255,.14);overflow:hidden}
.bar>i{display:block;height:100%;background:linear-gradient(90deg,var(--good),var(--gold));border-radius:99px;transition:width .6s}
#side{width:340px;flex:none;background:linear-gradient(180deg,#06264a,#041a33);border-left:1px solid var(--line);display:flex;flex-direction:column;min-height:0}
#side.hidden{display:none}
.view{display:flex;flex-direction:column;flex:1;min-height:0}
.view.hidden{display:none}
#side h2{margin:0;padding:18px 18px 4px;font-size:22px}
#side .sub{padding:0 18px 12px;color:var(--muted);font-size:13px;line-height:1.4}
#board,#feedList{flex:1;overflow-y:auto;padding:6px 8px 10px;border-top:1px solid var(--line)}
#board::-webkit-scrollbar,#feedList::-webkit-scrollbar{width:8px}
#board::-webkit-scrollbar-thumb,#feedList::-webkit-scrollbar-thumb{background:rgba(255,255,255,.15);border-radius:8px}
.row{display:grid;grid-template-columns:34px 14px 1fr auto;align-items:center;gap:8px;padding:5px 10px;border-radius:10px;cursor:pointer;font-size:15px}
.row:hover,.row.hl{background:rgba(255,255,255,.09)}
.rank{font-weight:700;color:var(--muted);text-align:center}
.dot{width:14px;height:14px;border-radius:50%;box-shadow:inset 0 -3px 0 rgba(0,0,0,.2)}
.nm{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.nm small{color:var(--muted);font-size:12px;margin-left:3px}
.sc{font-weight:600;font-variant-numeric:tabular-nums}
.row.sick .nm{color:var(--sick)}
#legend{border-top:1px solid var(--line);padding:10px 16px 14px;font-size:12.5px;color:var(--muted);line-height:1.65}
/* feeding panel */
.feedTop{display:flex;gap:8px;padding:0 14px 10px}
.feedTop select{flex:1;min-width:0}
#feedCount{padding:0 18px 8px;font-size:13px;color:var(--gold)}
.frow{display:grid;grid-template-columns:22px 1fr 66px 40px 20px;align-items:center;gap:6px;padding:4px 8px;border-radius:10px;font-size:15px}
.frow.hl{background:rgba(255,211,77,.12)}
.frow .num{color:var(--muted);font-size:12px;text-align:right}
.frow input{width:66px;padding:5px 8px;text-align:center;font-weight:600}
.frow input.err{border-color:var(--bad)}
.frow .mx{color:var(--muted);font-size:12px}
.frow .st{font-size:14px;text-align:center}
.feedFoot{display:flex;gap:6px;flex-wrap:wrap;padding:10px 12px 14px;border-top:1px solid var(--line)}
.feedFoot button{font-size:14px;padding:6px 11px}
.empty{padding:18px;color:var(--muted);text-align:center;line-height:1.5}
/* card */
#card{position:absolute;z-index:5;top:50%;left:50%;transform:translate(-50%,-50%);width:min(460px,calc(100% - 32px));max-height:calc(100% - 32px);overflow:auto;background:linear-gradient(180deg,rgba(8,44,82,.97),rgba(4,26,51,.97));border:1px solid var(--line);border-radius:20px;padding:18px 20px 16px;box-shadow:0 24px 70px rgba(0,0,0,.55)}
#card.hidden{display:none}
.close{position:absolute;top:10px;right:10px;width:34px;height:34px;padding:0;border-radius:50%;font-size:18px}
.cardHead{display:flex;gap:14px;align-items:center;padding-right:30px}
#cardFish{width:130px;height:86px;flex:none;background:radial-gradient(circle,rgba(80,170,255,.28),transparent 70%);border-radius:14px}
#cardName{font-size:24px;font-weight:700;margin:0;line-height:1.15}
.muted{color:var(--muted)}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:14px 0 10px}
.stat{background:var(--panel2);border-radius:12px;padding:8px 4px;text-align:center}
.stat b{display:block;font-size:20px}
.stat span{font-size:12px;color:var(--muted)}
.status{background:var(--panel2);border-radius:12px;padding:9px 12px;margin:6px 0;font-size:14.5px;line-height:1.4}
.prog{margin:10px 0 4px;font-size:13.5px;color:var(--muted)}
.prog .bar{width:100%;height:10px;margin-top:6px}
#chart{width:100%;height:auto;margin-top:8px;display:block}
/* modal */
#modal{position:fixed;inset:0;background:rgba(0,10,25,.6);z-index:20;display:flex;align-items:center;justify-content:center;padding:16px}
#modal.hidden{display:none}
.mbox{position:relative;width:min(480px,100%);max-height:calc(100vh - 32px);overflow:auto;background:linear-gradient(180deg,#0a3260,#05203f);border:1px solid var(--line);border-radius:20px;padding:20px 22px;box-shadow:0 24px 70px rgba(0,0,0,.55)}
.mbox h3{margin:0 40px 6px 0;font-size:22px}
.mbox p{color:var(--muted);line-height:1.45;margin:6px 0 12px;font-size:14.5px}
.mbox label{display:block;font-size:13.5px;color:var(--muted);margin:12px 0 5px}
.mbox input[type=text],.mbox input[type=password],.mbox input[type=number],.mbox textarea{width:100%}
.mbox .actions{display:flex;gap:8px;justify-content:flex-end;margin-top:16px}
.mbox .err{color:var(--bad);font-size:14px;min-height:18px;margin-top:8px}
.slist{max-height:220px;overflow:auto;border:1px solid var(--line);border-radius:12px;padding:4px}
.srow{display:flex;align-items:center;gap:8px;padding:5px 8px;border-radius:8px;font-size:14.5px}
.srow:hover{background:rgba(255,255,255,.06)}
.srow span{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.srow button{font-size:13px;padding:3px 10px}
.srow button.danger{border-color:var(--bad);color:var(--bad)}
.check{display:flex;align-items:center;gap:8px;margin-top:12px;font-size:14.5px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:0 12px}
#toast{position:absolute;left:50%;top:80px;transform:translateX(-50%);background:var(--panel);border:1px solid var(--gold);color:var(--gold);padding:8px 16px;border-radius:999px;z-index:6;opacity:0;transition:opacity .3s;pointer-events:none;font-size:15px;max-width:90%;text-align:center}
#toast.show{opacity:1}
#msg{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;z-index:4;pointer-events:none}
#msg div{background:var(--panel);border:1px solid var(--line);padding:16px 22px;border-radius:16px;font-size:18px;max-width:80%;text-align:center}
#msg.hidden{display:none}
@media (max-width:900px){#side{width:280px}.row{font-size:14px}}
</style>
</head>
<body>
<div id="app">
  <div id="tankWrap">
    <canvas id="tank"></canvas>
    <div id="topbar">
      <div id="title">Class Aquarium<small>Loading…</small></div>
      <div class="pill" id="sectionCtl" title="Switch section"><span>🏫</span><select id="sectionSel"></select></div>
      <div class="pill" id="examCtl" title="Slide to see the tank after each exam">
        <span>📅</span>
        <input type="range" id="exam" min="-1" max="0" step="1" value="0">
        <span id="examLabel">—</span>
      </div>
      <button id="play" title="Watch the class grow exam by exam">▶ Replay</button>
      <button id="labels" class="on" title="Show/hide names (L)">🏷️ Names</button>
      <button id="boardBtn" class="on" title="Show/hide the side panel (B)">🏆 Board</button>
      <button id="fs" title="Full screen (F)">⛶</button>
      <button id="teachBtn" title="Teacher mode: feed the fish (enter scores)">🔒 Teacher</button>
    </div>
    <div id="bottombar">
      <div class="pill" id="avgPill">Class average —</div>
      <div class="pill" id="unlockPill">—</div>
      <div class="pill" id="updated" style="margin-left:auto">—</div>
    </div>
    <div id="card" class="hidden">
      <button class="close" id="cardClose" aria-label="Close">×</button>
      <div class="cardHead">
        <canvas id="cardFish" width="260" height="172"></canvas>
        <div><h2 id="cardName"></h2><div id="cardSub" class="muted"></div></div>
      </div>
      <div class="stats" id="cardStats"></div>
      <div id="cardStatus"></div>
      <div class="prog" id="cardProg"></div>
      <svg id="chart" viewBox="0 0 420 160"></svg>
    </div>
    <div id="toast"></div>
    <div id="msg" class="hidden"><div></div></div>
  </div>
  <aside id="side">
    <div class="view" id="boardView">
      <h2>🏆 Leaderboard</h2>
      <div class="sub" id="sideSub">Ranked by total score</div>
      <div id="board"></div>
      <div id="legend">
        👑 Top of the class &nbsp; ✨ Most improved<br>
        🤒 Sick (scored 0 on the latest exam)<br>
        🩹 Scar (heals with a passing score)<br>
        Fry → Juvenile → Adult → Legend
      </div>
    </div>
    <div class="view hidden" id="feedView">
      <h2>🍤 Feeding time</h2>
      <div class="sub">Type a score and press <b>Enter</b>. The fish swims up to eat it and the next student is ready. Leave it empty if absent.</div>
      <div class="feedTop"><select id="feedExam"></select><button id="newExamBtn">➕ New exam</button></div>
      <div id="feedCount"></div>
      <div id="feedList"></div>
      <div class="feedFoot">
        <button id="stuBtn">👥 Students</button>
        <button id="secBtn">🏫 Sections</button>
        <button id="setBtn">⚙️ Settings</button>
      </div>
    </div>
  </aside>
</div>
<div id="modal" class="hidden"><div class="mbox"><button class="close" id="modalClose" aria-label="Close">×</button><div id="mbody"></div></div></div>

<script>
/* ================================================================
   🔗 PASTE YOUR APPS SCRIPT LINK HERE (the one that ends in /exec)
   Find it in Apps Script: Deploy → Manage deployments,
   or in the sheet: 🐠 Aquarium → Show the aquarium link.
   Leave it empty to see the demo.
   ================================================================ */
var API_URL = '';
</script>
<script>
(function(){
'use strict';

var DEFAULTS = { className:'Class Aquarium', expectedExams:10, passingPercent:75, refreshSeconds:60, showFishNames:false };
var STAGES = [ {name:'Fry',at:0}, {name:'Juvenile',at:.15}, {name:'Adult',at:.40}, {name:'Legend',at:.70} ];
var DECOR = [
  {at:50, name:'Coral reef',     icon:'🪸', key:'coral'},
  {at:65, name:'Seashells',      icon:'🐚', key:'shells'},
  {at:75, name:'Treasure chest', icon:'💰', key:'chest'},
  {at:85, name:'Submarine',      icon:'⚓', key:'sub'}
];

/* Three ways to run:
   gas    – served by Google Apps Script itself (google.script.run is available)
   remote – hosted anywhere else (e.g. GitHub Pages), talking to API_URL
   demo   – no link set: built-in sample classes, nothing is saved           */
var QP = new URLSearchParams(location.search);
var gas = !!(window.google && google.script && google.script.run);
var apiUrl = String(QP.get('api') || window.API_URL || '').trim();
var remote = !gas && /^https:\/\/script\.google(usercontent)?\.com\//.test(apiUrl);
var live = gas || remote;
var setupProblem = '';
if (!gas && apiUrl && !remote) setupProblem = 'API_URL does not look like an Apps Script link. It should start with https://script.google.com/';
else if (remote && /\/dev(\?|$)/.test(apiUrl)) setupProblem = 'API_URL is a "/dev" test link, which only works for you. Use the link that ends in /exec.';
var DATA = null, CFG = Object.assign({}, DEFAULTS), currentSection = '';
var viewExam = -1, followLatest = true, showLabels = true;
var models = [], sortedModels = [], fishes = new Map(), classAvg = null, unlocked = new Set();
var hoverKey = null, cardKey = null, playTimer = null;
var teacher = { on:false, pin:null }, feedExam = -1, lastAct = Date.now();

function $(id){ return document.getElementById(id); }
function clamp(v,a,b){ return Math.max(a, Math.min(b, v)); }
function rnd(a,b){ return a + Math.random()*(b-a); }
function hash(s){ var h=2166136261; for(var i=0;i<s.length;i++){ h^=s.charCodeAt(i); h=Math.imul(h,16777619); } return h>>>0; }
function esc(s){ return String(s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];}); }
function fmt(n){ return Math.round(n*10)/10; }
/* Short label for the tank ("Dela Cruz, Juan Miguel" -> "Juan D."). Full names stay on the board and cards. */
function nameOf(m){
  if (CFG.showFishNames && m.nick) return m.nick;
  var n = m.name.trim(), parts;
  if (n.indexOf(',') > 0){
    var sur = n.slice(0, n.indexOf(',')).trim(), first = n.slice(n.indexOf(',') + 1).trim().split(/\s+/)[0] || '';
    return first ? first + ' ' + sur.charAt(0) + '.' : sur;
  }
  if (n.length <= 16) return n;
  parts = n.split(/\s+/);
  return parts.length > 1 ? parts[0] + ' ' + parts[parts.length-1].charAt(0) + '.' : n.slice(0, 15) + '…';
}
function errText(e){
  var m = (e && e.message) || String(e || 'Something went wrong.');
  return m.replace(/^(?:\s*\w*(?:Error|Exception):\s*)+/, '').replace(/^(NO_PIN|WRONG_PIN):\s*/, '');
}
function isAuthErr(e){ return /WRONG_PIN|NO_PIN/.test((e && e.message) || String(e)); }

/* ---------- backend calls (Google Apps Script, or a local demo) ---------- */
function api(fn){
  var args = Array.prototype.slice.call(arguments, 1);
  if (remote) return fetchApi(fn, args, fn === 'getData' ? 1 : 0);
  return new Promise(function(res, rej){
    if (gas){
      var r = google.script.run.withSuccessHandler(res).withFailureHandler(rej);
      r[fn].apply(r, args);
    } else {
      setTimeout(function(){
        try { res(JSON.parse(JSON.stringify(MOCK[fn].apply(null, args)))); } catch(e){ rej(e); }
      }, 220);
    }
  });
}

/* Calls the Apps Script web app over HTTPS. Text/plain POST avoids a CORS
   pre-flight, which Apps Script cannot answer. Read requests retry once. */
var ACCESS_HINT = 'In Apps Script, open Deploy → Manage deployments and check that "Who has access" is set to "Anyone", and that API_URL is the link ending in /exec.';
function fetchApi(fn, args, retries){
  var ctrl = window.AbortController ? new AbortController() : null;
  var timer = setTimeout(function(){ if (ctrl) ctrl.abort(); }, 45000);
  return fetch(apiUrl, {
    method:'POST', redirect:'follow', cache:'no-store',
    headers:{ 'Content-Type':'text/plain;charset=utf-8' },
    body: JSON.stringify({ fn:fn, args:args }),
    signal: ctrl ? ctrl.signal : undefined
  }).then(function(r){
    return r.text();
  }, function(err){
    clearTimeout(timer);
    if (retries > 0) return 'RETRY';
    throw new Error(err && err.name === 'AbortError'
      ? 'The sheet took too long to answer. Please try again.'
      : 'Could not reach your Apps Script link. Check the internet connection. ' + ACCESS_HINT);
  }).then(function(txt){
    clearTimeout(timer);
    if (txt === 'RETRY') return new Promise(function(r){ setTimeout(r, 1500); }).then(function(){ return fetchApi(fn, args, retries - 1); });
    var j;
    try { j = JSON.parse(txt); } catch (e){ throw new Error('Your Apps Script link answered with a web page instead of data. ' + ACCESS_HINT); }
    if (!j || typeof j.ok !== 'boolean') throw new Error('Unexpected answer from the Apps Script link. Is Code.gs up to date?');
    if (!j.ok) throw new Error(j.error || 'Something went wrong.');
    return j.result;
  });
}

/* ---------- data ---------- */
var loadSeq = 0;
function load(){
  var my = ++loadSeq;
  return api('getData', currentSection).then(function(d){
    if (my === loadSeq) onData(d);     // ignore answers that arrive after a newer request
  }).catch(function(e){
    if (my !== loadSeq) return;
    if (DATA) toast('⚠ Could not refresh: ' + errText(e) + ' Will try again soon.');
    else showMsg('Could not read the sheet: ' + errText(e) + ' Please reload the page.');
  });
}

function onData(d){
  if (!d || !Array.isArray(d.students) || !Array.isArray(d.exams)) { toast('⚠ The sheet returned unexpected data.'); return; }
  loadSeq++;   // any older getData still in flight is now stale
  d.sections = Array.isArray(d.sections) && d.sections.length ? d.sections : [d.section || 'Class'];
  d.max = d.exams.map(function(_, i){ var m = d.max && Number(d.max[i]); return m > 0 ? m : 100; });
  d.students.forEach(function(s){
    s.name = String(s.name); s.nick = s.nick ? String(s.nick) : '';
    s.scores = d.exams.map(function(_, i){ var v = s.scores && s.scores[i]; return (v === null || v === undefined || v === '' || !isFinite(Number(v))) ? null : Number(v); });
  });
  hideMsg();
  var sectionChanged = DATA && DATA.section !== d.section;
  if (sectionChanged){ flushFoods(); fishes.clear(); closeCard(); }
  DATA = d;
  currentSection = d.section;
  CFG = Object.assign({}, DEFAULTS, d.settings || {});
  document.title = CFG.className + ' – ' + d.section;
  $('title').innerHTML = esc(CFG.className) + '<small>' + (live ? '' : 'Demo (no API_URL set) · ') + esc(d.section) + ' · ' + d.students.length + ' fish in the tank</small>';
  var sel = $('sectionSel');
  sel.innerHTML = d.sections.map(function(s){ return '<option' + (s === d.section ? ' selected' : '') + '>' + esc(s) + '</option>'; }).join('');
  $('sectionCtl').style.display = (d.sections.length > 1 || teacher.on) ? '' : 'none';
  updateLast();
  if (followLatest || viewExam > DATA.lastExam || sectionChanged) viewExam = DATA.lastExam;
  syncExamControls();
  $('updated').textContent = (live ? 'Updated ' : 'Demo · ') + new Date().toLocaleTimeString([], {hour:'numeric', minute:'2-digit'});
  if (!d.students.length) showMsg(teacher.on ? 'This tank is empty. Click 👥 Students to add your class.' : 'No fish yet. A teacher can add students in Teacher mode.');
  recompute();
  if (teacher.on){
    if (feedExam < 0 || feedExam >= DATA.exams.length || sectionChanged) feedExam = defaultFeedExam();
    renderFeed();
  }
}

function updateLast(){
  var last = -1;
  DATA.exams.forEach(function(_, e){ if (DATA.students.some(function(s){ return s.scores[e] !== null && s.scores[e] !== undefined; })) last = e; });
  DATA.lastExam = last;
}
function syncExamControls(){
  var s = $('exam');
  s.max = Math.max(0, DATA.lastExam);
  s.value = viewExam;
  $('examCtl').style.display = DATA.lastExam >= 0 ? '' : 'none';
  $('play').style.display = DATA.lastExam >= 0 ? '' : 'none';
}

function recompute(){
  var k = viewExam, pass = CFG.passingPercent, exp = Math.max(1, CFG.expectedExams);
  var allPct = 0, allN = 0, seen = {};
  models = DATA.students.map(function(s, i){
    var points = 0, total = 0, lastZero = -1, taken = [];
    for (var e = 0; e <= k; e++){
      var sc = s.scores[e];
      if (sc === null || sc === undefined) continue;
      var mx = (DATA.max && DATA.max[e]) || 100;
      var pct = clamp(sc / mx * 100, 0, 100);
      points += pct; total += sc; allPct += pct; allN++;
      taken.push({e:e, sc:sc, pct:pct});
      if (sc === 0) lastZero = taken.length - 1;
    }
    var latest = taken.length ? taken[taken.length-1] : null;
    var sick = !!latest && latest.sc === 0;
    var scar = false, healed = false, zeroExam = null;
    if (lastZero >= 0){
      zeroExam = DATA.exams[taken[lastZero].e];
      if (!sick){
        var passed = taken.slice(lastZero+1).some(function(x){ return x.pct >= pass; });
        scar = !passed; healed = passed;
      }
    }
    var delta = null;
    if (latest && latest.e === k && taken.length >= 2) delta = latest.pct - taken[taken.length-2].pct;
    var g = clamp(points / (exp*100), 0, 1);
    var stage = 0;
    STAGES.forEach(function(st, j){ if (g >= st.at) stage = j; });
    var key = s.name; seen[key] = (seen[key] || 0) + 1; if (seen[key] > 1) key += '#' + seen[key];
    return { key:key, i:i, name:s.name, nick:s.nick||'', points:points, total:total, taken:taken,
      latest:latest, sick:sick, scar:scar, healed:healed, zeroExam:zeroExam, delta:delta, g:g, stage:stage,
      avg: taken.length ? points/taken.length : null, hue: hash(s.name) % 360, crown:false, improved:false, rank:0 };
  });

  sortedModels = models.slice().sort(function(a,b){ return b.points - a.points || a.name.localeCompare(b.name); });
  sortedModels.forEach(function(m, j){
    var prev = sortedModels[j-1];
    m.rank = (prev && Math.abs(m.points - prev.points) < 1e-9) ? prev.rank : j+1;
  });
  if (sortedModels.length && sortedModels[0].points > 0) sortedModels.forEach(function(m){ if (m.rank === 1) m.crown = true; });

  var best = 0;
  models.forEach(function(m){ if (m.delta !== null && m.delta > best) best = m.delta; });
  if (best >= 5) models.forEach(function(m){ if (m.delta !== null && Math.abs(m.delta - best) < 1e-9) m.improved = true; });

  classAvg = allN ? allPct/allN : null;
  unlocked = new Set(DECOR.filter(function(d){ return classAvg !== null && classAvg >= d.at; }).map(function(d){ return d.key; }));

  syncFish();
  renderBoard();
  renderBottom();
  renderExamLabel();
  if (cardKey) renderCard();
}

/* ---------- canvas setup ---------- */
var cv = $('tank'), ctx = cv.getContext('2d');
var W = 0, H = 0, DPR = 1, SC = 1;
var scene = { weeds:[], pebbles:[], rays:[], plankton:[], vents:[] };
var rayGrad = null;

function sandY(x){ return H*.87 + Math.sin(x*.012)*7*SC + Math.sin(x*.031+1)*4*SC; }

function resize(){
  var r = cv.getBoundingClientRect();
  if (!r.width || !r.height) return;
  W = r.width; H = r.height;
  // big screens / projectors: use fewer pixels so older laptops stay smooth
  DPR = Math.min(W*H > 1.8e6 ? 1.25 : 2, window.devicePixelRatio || 1);
  cv.width = Math.round(W*DPR); cv.height = Math.round(H*DPR);
  ctx.setTransform(DPR,0,0,DPR,0,0);
  SC = clamp(Math.min(W/1300, H/760), .5, 1.5);
  buildScene();
  fishes.forEach(function(f){ f.x = clamp(f.x, 10, W-10); f.y = clamp(f.y, 40, H*.85); f.newTarget(); });
}

/* Static parts (water colour, sand, vignette) are painted once into hidden layers
   and copied each frame, instead of being redrawn from scratch 60 times a second. */
var layers = { bg:document.createElement('canvas'), sand:document.createElement('canvas'), vig:document.createElement('canvas') };
function layerCtx(cn){
  cn.width = cv.width; cn.height = cv.height;
  var c = cn.getContext('2d'); c.setTransform(DPR,0,0,DPR,0,0); return c;
}
function buildLayers(){
  rayGrad = null;
  var b = layerCtx(layers.bg);
  var g = b.createLinearGradient(0,0,0,H);
  g.addColorStop(0,'#2a8cc4'); g.addColorStop(.35,'#0f5b93'); g.addColorStop(1,'#04203d');
  b.fillStyle = g; b.fillRect(0,0,W,H);

  var s = layerCtx(layers.sand);
  var sg = s.createLinearGradient(0, H*.84, 0, H);
  sg.addColorStop(0, '#e2c98f'); sg.addColorStop(1, '#a8884d');
  s.fillStyle = sg; s.beginPath(); s.moveTo(0, H);
  for (var x = 0; x <= W + 20; x += 20) s.lineTo(x, sandY(x));
  s.lineTo(W, H); s.closePath(); s.fill();
  scene.pebbles.forEach(function(p){
    s.fillStyle = 'hsl(30,20%,' + p.l + '%)';
    s.beginPath(); s.ellipse(p.x, sandY(p.x) + p.dy, p.r*1.3, p.r, 0, 0, 7); s.fill();
  });

  var v = layerCtx(layers.vig);
  var vg = v.createRadialGradient(W/2,H/2,Math.min(W,H)*.35,W/2,H/2,Math.max(W,H)*.75);
  vg.addColorStop(0,'rgba(0,0,0,0)'); vg.addColorStop(1,'rgba(0,10,25,.45)');
  v.fillStyle = vg; v.fillRect(0,0,W,H);
}
function buildScene(){
  scene.weeds = [];
  var n = Math.round(W/62);
  for (var i=0;i<n;i++) scene.weeds.push({ x:rnd(0,W), h:rnd(70,190)*SC, w:rnd(6,11)*SC, hue:rnd(105,160), ph:rnd(0,6.28), front: Math.random()<.18 });
  scene.pebbles = [];
  for (i=0;i<Math.round(W/16);i++){ scene.pebbles.push({ x:rnd(0,W), dy:rnd(6,H*.12), r:rnd(2,6)*SC, l:rnd(45,75) }); }
  scene.rays = [];
  for (i=0;i<6;i++) scene.rays.push({ x:rnd(.05,.95), w:rnd(30,90)*SC, s:rnd(.08,.2), p:rnd(0,6), sk:rnd(-.6,.6) });
  scene.plankton = [];
  for (i=0;i<70;i++) scene.plankton.push({ x:rnd(0,W), y:rnd(0,H*.85), r:rnd(.6,1.8)*SC, s:rnd(3,10), p:rnd(0,6) });
  scene.vents = [ {x:W*.23, t:0}, {x:W*.71, t:1.3}, {x:W*.93, t:2.1} ];
  buildLayers();
}

/* ---------- fish ---------- */
function Fish(m){
  this.m = m; this.prevStage = m.stage; this.prevSick = m.sick; this.prevScar = m.scar;
  this.x = rnd(.08,.92)*W; this.y = rnd(.2,.72)*H;
  this.vx = rnd(-20,20); this.vy = 0;
  this.size = 4; this.flip = this.vx < 0 ? -1 : 1; this.tilt = 0;
  this.phase = rnd(0,6.28); this.wagP = rnd(0,6.28); this.spd = rnd(.7,1.3);
  this.bubbleT = rnd(1,7); this.food = null; this.chomp = 0;
  this.newTarget();
}
Fish.prototype.setModel = function(m){
  if ((this.prevSick && !m.sick) || (this.prevScar && !m.scar && !m.sick)) burst(this.x, this.y, 'heal');
  else if (m.stage > this.prevStage) burst(this.x, this.y, 'grow');
  else if (!this.prevSick && m.sick) burst(this.x, this.y, 'sick');
  var changed = this.prevSick !== m.sick;
  this.prevSick = m.sick; this.prevScar = m.scar; this.prevStage = m.stage; this.m = m;
  if (changed) this.newTarget();
};
Fish.prototype.targetLen = function(){
  var crowd = fishes.size > 40 ? .88 : 1;
  return (20 + this.m.g*92) * SC * crowd;
};
Fish.prototype.newTarget = function(){
  var sy = H*.86;
  if (this.m.sick){ this.tx = rnd(.06,.94)*W; this.ty = rnd(sy - H*.17, sy - H*.07); }
  else { this.tx = rnd(.04,.96)*W; this.ty = rnd(H*.17, sy - H*.13); }
};
Fish.prototype.update = function(dt){
  var m = this.m;
  this.size += (this.targetLen() - this.size) * Math.min(1, dt*1.4);
  this.chomp = Math.max(0, this.chomp - dt*1.5);
  var max = (34 + 26*this.spd) * SC * (m.sick ? .33 : 1) * (m.stage === 0 ? 1.15 : 1);
  var hungry = this.food && !this.food.eaten;
  if (hungry){ this.tx = this.food.x; this.ty = this.food.y; max = Math.max(max*2, 90*SC); }
  var dx = this.tx - this.x, dy = this.ty - this.y, d = Math.hypot(dx,dy) || 1;
  if (hungry){
    if (d < this.size*.45 + 10*SC) eatFood(this.food, this);
  } else if (d < 25*SC) this.newTarget();
  var k = Math.min(1, dt*(hungry ? 2 : .9));
  this.vx += (dx/d*max - this.vx) * k;
  this.vy += (dy/d*max*(hungry ? 1 : .55) - this.vy) * k;
  this.x += this.vx*dt; this.y += this.vy*dt;
  this.x = clamp(this.x, 10, W-10); this.y = clamp(this.y, 40, H*.86 - 4);
  var ft = this.vx >= 0 ? 1 : -1;
  this.flip += (ft - this.flip) * Math.min(1, dt*5);
  var sp = Math.hypot(this.vx, this.vy);
  var want = clamp(Math.atan2(this.vy, Math.abs(this.vx)+1)*.6, -.45, .45) * (this.flip < 0 ? -1 : 1);
  this.tilt += (want - this.tilt) * Math.min(1, dt*3);
  this.wagP += dt * (m.sick && !hungry ? 2.5 : 6 + sp/max*4);
  this.bubbleT -= dt;
  if (this.bubbleT <= 0){
    var mx = this.x + (this.flip < 0 ? -1 : 1) * this.size*.42;
    if (m.sick){ bubble(mx, this.y, 'sick'); this.bubbleT = rnd(.8,1.6); }
    else { bubble(mx, this.y, 'fish'); this.bubbleT = rnd(4,10); }
  }
};

function rr(c,x,y,w,h,r){
  c.beginPath(); c.moveTo(x+r,y); c.lineTo(x+w-r,y); c.quadraticCurveTo(x+w,y,x+w,y+r);
  c.lineTo(x+w,y+h-r); c.quadraticCurveTo(x+w,y+h,x+w-r,y+h); c.lineTo(x+r,y+h);
  c.quadraticCurveTo(x,y+h,x,y+h-r); c.lineTo(x,y+r); c.quadraticCurveTo(x,y,x+r,y); c.closePath();
}

/* Draws a fish centred at 0,0 facing right, body length L. */
function drawFishShape(c, L, o){
  var st = o.stage, H = L * (st === 0 ? .6 : .52);
  var hue = o.sick ? 85 : o.hue;
  var sat = o.sick ? 22 : (st === 0 ? 55 : 78);
  var lit = o.sick ? 58 : (st === 0 ? 68 : 57);
  var base = 'hsl('+hue+','+sat+'%,'+lit+'%)';
  var dark = 'hsl('+((hue+(o.sick?0:12))%360)+','+sat+'%,'+(lit-20)+'%)';
  var light = 'hsl('+hue+','+sat+'%,'+Math.min(92,lit+22)+'%)';
  c.globalAlpha = st === 0 ? .9 : 1;

  c.save(); c.translate(-L*.36, 0); c.rotate(o.wag);
  var tl = L*(st >= 2 ? .36 : .28), th = H*(st >= 3 ? .8 : .55);
  c.beginPath(); c.moveTo(0,0);
  c.quadraticCurveTo(-tl*.5, -th*.3, -tl, -th);
  c.quadraticCurveTo(-tl*.65, 0, -tl, th);
  c.quadraticCurveTo(-tl*.5, th*.3, 0, 0);
  c.fillStyle = dark; c.fill();
  if (st >= 3){ c.strokeStyle = 'rgba(255,220,120,.7)'; c.lineWidth = Math.max(1, L*.012); c.stroke(); }
  c.restore();

  if (st >= 1){
    c.beginPath(); c.moveTo(-L*.22, -H*.36);
    c.quadraticCurveTo(-L*.08, -H*(st >= 3 ? 1.1 : st === 2 ? .92 : .75), L*.14, -H*.42);
    c.closePath(); c.fillStyle = dark; c.fill();
  }
  if (st >= 2){
    c.beginPath(); c.moveTo(-L*.2, H*.36);
    c.quadraticCurveTo(-L*.12, H*(st >= 3 ? .85 : .7), L*.02, H*.42);
    c.closePath(); c.fillStyle = dark; c.fill();
  }

  var g = c.createLinearGradient(0, -H/2, 0, H/2);
  g.addColorStop(0, light); g.addColorStop(.55, base); g.addColorStop(1, dark);
  c.beginPath(); c.ellipse(0, 0, L*.42, H*.5, 0, 0, Math.PI*2);
  c.fillStyle = g; c.fill();

  if (st >= 1 && !o.sick){
    c.save(); c.clip();
    c.fillStyle = 'hsla('+((hue+35)%360)+',85%,'+(lit-8)+'%,.45)';
    var bands = st >= 2 ? [-.24,-.06,.12] : [-.12,.08];
    bands.forEach(function(b){ c.beginPath(); c.ellipse(L*b, 0, L*.035, H*.6, 0, 0, Math.PI*2); c.fill(); });
    if (st >= 2){ c.fillStyle = 'rgba(255,255,255,.22)'; c.beginPath(); c.ellipse(L*.02, H*.32, L*.32, H*.16, 0, 0, Math.PI*2); c.fill(); }
    if (st >= 3){
      c.strokeStyle = 'rgba(255,235,160,.35)'; c.lineWidth = Math.max(.8, L*.008);
      for (var sx = -.3; sx < .25; sx += .08) for (var sy = -.3; sy < .35; sy += .2){
        c.beginPath(); c.arc(L*sx, H*sy, L*.04, -1.2, 1.2); c.stroke();
      }
    }
    c.restore();
  }
  if (st >= 3){
    c.beginPath(); c.ellipse(0, 0, L*.42, H*.5, 0, 0, Math.PI*2);
    c.strokeStyle = 'rgba(255,214,90,.95)'; c.lineWidth = Math.max(1.2, L*.02); c.stroke();
  }

  c.beginPath(); c.arc(L*.14, 0, H*.32, -1.1, 1.1);
  c.strokeStyle = 'rgba(0,0,0,.18)'; c.lineWidth = Math.max(1, L*.015); c.stroke();

  if (o.scar){
    c.save(); c.strokeStyle = 'rgba(255,225,225,.95)'; c.lineWidth = Math.max(1.4, L*.022); c.lineCap = 'round';
    c.beginPath(); c.moveTo(-L*.16, -H*.26); c.lineTo(-L*.02, H*.2); c.stroke();
    c.lineWidth = Math.max(1, L*.014);
    for (var q = 0; q < 3; q++){
      var t1 = .2 + q*.3, px = -L*.16 + L*.14*t1, py = -H*.26 + H*.46*t1;
      c.beginPath(); c.moveTo(px - L*.04, py + H*.02); c.lineTo(px + L*.04, py - H*.02); c.stroke();
    }
    c.restore();
  }

  if (o.sick){
    c.save(); c.translate(-L*.08, -H*.08); c.rotate(-.45);
    rr(c, -L*.13, -H*.11, L*.26, H*.22, H*.06);
    c.fillStyle = '#f2d3a2'; c.fill(); c.strokeStyle = 'rgba(120,80,40,.5)'; c.lineWidth = 1; c.stroke();
    c.fillStyle = 'rgba(120,80,40,.45)';
    for (var b2 = -1; b2 <= 1; b2 += 2) for (var b3 = -1; b3 <= 1; b3 += 2){ c.beginPath(); c.arc(b2*L*.03, b3*H*.035, Math.max(.7, L*.008), 0, 7); c.fill(); }
    c.restore();
  }

  c.save(); c.translate(L*.05, H*.12); c.rotate(.5 + o.fin*.35);
  c.beginPath(); c.ellipse(-L*.06, 0, L*.09, H*.1, 0, 0, Math.PI*2);
  c.fillStyle = dark; c.globalAlpha *= .85; c.fill(); c.restore();

  var er = Math.max(2.2, L*(st === 0 ? .1 : .075)), ex = L*.24, ey = -H*.1;
  c.beginPath(); c.arc(ex, ey, er, 0, 7); c.fillStyle = '#fff'; c.fill();
  c.beginPath(); c.arc(ex + er*.18, ey + (o.sick ? er*.25 : 0), er*.55, 0, 7); c.fillStyle = '#122'; c.fill();
  c.beginPath(); c.arc(ex + er*.35, ey - er*.25, er*.2, 0, 7); c.fillStyle = '#fff'; c.fill();
  if (o.sick){
    c.beginPath(); c.arc(ex, ey, er*1.05, Math.PI, 0); c.lineTo(ex+er, ey - er*.05); c.closePath();
    c.fillStyle = base; c.fill();
    c.beginPath(); c.moveTo(ex-er, ey); c.lineTo(ex+er, ey); c.strokeStyle = dark; c.lineWidth = 1; c.stroke();
  }

  c.beginPath();
  if (o.chomp > .05){ c.arc(L*.37, H*.06, L*.05*(.5+o.chomp), 0, 7); c.fillStyle = 'rgba(40,10,10,.7)'; c.fill(); }
  else {
    if (o.sick) c.arc(L*.36, H*.2, L*.035, Math.PI*1.15, Math.PI*1.85);
    else c.arc(L*.35, H*.08, L*.035, .2, 1.4);
    c.strokeStyle = 'rgba(0,0,0,.45)'; c.lineWidth = Math.max(1, L*.014); c.stroke();
  }
  c.globalAlpha = 1;
}

function drawStar(c, x, y, r, col){
  c.fillStyle = col; c.beginPath();
  c.moveTo(x, y-r); c.quadraticCurveTo(x, y, x+r, y); c.quadraticCurveTo(x, y, x, y+r);
  c.quadraticCurveTo(x, y, x-r, y); c.quadraticCurveTo(x, y, x, y-r); c.fill();
}

function drawCrown(c, x, y, w, t){
  var h = w*.72;
  c.save(); c.translate(x, y); c.rotate(Math.sin(t*2)*.07);
  c.beginPath(); c.moveTo(-w/2, 0); c.lineTo(-w/2, -h*.62); c.lineTo(-w/4, -h*.3); c.lineTo(0, -h);
  c.lineTo(w/4, -h*.3); c.lineTo(w/2, -h*.62); c.lineTo(w/2, 0); c.closePath();
  var g = c.createLinearGradient(0, -h, 0, 0); g.addColorStop(0, '#fff3a0'); g.addColorStop(1, '#e8a812');
  c.fillStyle = g; c.fill(); c.strokeStyle = '#a8740a'; c.lineWidth = 1.2; c.stroke();
  c.fillStyle = '#ff4f6d';
  [[-w/2,-h*.62],[0,-h],[w/2,-h*.62]].forEach(function(p){ c.beginPath(); c.arc(p[0], p[1], w*.07, 0, 7); c.fill(); });
  c.fillStyle = '#4fd1ff'; c.beginPath(); c.arc(0, -h*.18, w*.08, 0, 7); c.fill();
  c.restore();
}

function drawFishEntity(c, f, t){
  var m = f.m, L = f.size*(1 + f.chomp*.25), x = f.x, y = f.y, dir = f.flip < 0 ? -1 : 1;
  if (m.improved){
    var r = L*.9 + Math.sin(t*3)*5*SC;
    var g = c.createRadialGradient(x, y, L*.1, x, y, r);
    g.addColorStop(0, 'rgba(140,255,240,.5)'); g.addColorStop(1, 'rgba(140,255,240,0)');
    c.fillStyle = g; c.beginPath(); c.arc(x, y, r, 0, 7); c.fill();
  }
  if (m.stage === 3){
    var r2 = L*.75;
    var g2 = c.createRadialGradient(x, y, L*.1, x, y, r2);
    g2.addColorStop(0, 'rgba(255,215,100,.28)'); g2.addColorStop(1, 'rgba(255,215,100,0)');
    c.fillStyle = g2; c.beginPath(); c.arc(x, y, r2, 0, 7); c.fill();
  }
  if (hoverKey === m.key || cardKey === m.key){
    c.save(); c.strokeStyle = 'rgba(255,211,77,.95)'; c.lineWidth = 2; c.setLineDash([6,5]); c.lineDashOffset = -t*20;
    c.beginPath(); c.ellipse(x, y, L*.64, L*.44, 0, 0, 7); c.stroke(); c.restore();
  }
  c.save(); c.translate(x, y); c.rotate(f.tilt); c.scale(f.flip, 1);
  drawFishShape(c, L, { hue:m.hue, stage:m.stage, sick:m.sick, scar:m.scar, chomp:f.chomp,
    wag: Math.sin(f.wagP) * (m.sick ? .12 : .3), fin: Math.sin(f.wagP*.7) });
  c.restore();
  if (m.stage === 3){
    for (var i = 0; i < 3; i++){
      var a = t*1.4 + i*2.1 + f.phase;
      drawStar(c, x + Math.cos(a)*L*.58, y + Math.sin(a*1.3)*L*.38, (2.5 + Math.sin(t*5+i)*1.5)*SC, 'rgba(255,240,170,.9)');
    }
  }
  if (m.crown) drawCrown(c, x + dir*L*.1, y - L*.27 - 3*SC, clamp(L*.36, 14*SC, 32*SC), t);
  if (showLabels){
    var fs = Math.round(clamp(11*SC + L*.035, 11, 17));
    c.font = '600 ' + fs + 'px Fredoka, system-ui, sans-serif';
    var txt = (m.sick ? '🤒 ' : '') + (m.improved ? '✨ ' : '') + nameOf(m);
    var lk = txt + '|' + fs;
    if (f.lblKey !== lk){ f.lblW = c.measureText(txt).width; f.lblKey = lk; }   // measure text only when it changes
    var tw = f.lblW, ly = y + L*.3 + fs*.9 + 2;
    rr(c, x - tw/2 - 7, ly - fs*.78, tw + 14, fs*1.4, fs*.7);
    c.fillStyle = m.sick ? 'rgba(45,62,20,.72)' : 'rgba(0,18,38,.58)'; c.fill();
    c.fillStyle = m.sick ? '#d9f7aa' : '#fff'; c.textAlign = 'center'; c.textBaseline = 'middle';
    c.fillText(txt, x, ly - fs*.08);
  }
}

/* ---------- bubbles, particles, popups ---------- */
var bubbles = [], parts = [], popups = [];
function bubble(x, y, kind, r){
  if (bubbles.length > 260) return;
  bubbles.push({ x:x, y:y, r:r || (kind === 'sick' ? rnd(2.5,4.5) : rnd(1.5,3.5))*SC,
    vy: rnd(25,45)*SC*(kind === 'sick' ? .5 : 1), ph: rnd(0,6), kind:kind, life:0 });
}
function burst(x, y, kind){
  var col = kind === 'heal' ? '#8dffb0' : kind === 'sick' ? '#c7e88a' : kind === 'crumb' ? '#ffcf8a' : '#ffe27a';
  var n = kind === 'sick' ? 8 : kind === 'crumb' ? 7 : 18;
  for (var i = 0; i < n; i++){
    var a = rnd(0, 6.28), s = rnd(30,90)*SC*(kind === 'crumb' ? .5 : 1);
    parts.push({ x:x, y:y, vx:Math.cos(a)*s, vy:Math.sin(a)*s - 20*SC, life:0, max:rnd(.8,1.5), col:col,
      r:rnd(3,6)*SC*(kind === 'crumb' ? .6 : 1), heart: kind === 'heal' && i%3 === 0 });
  }
}
function popup(x, y, text, col){ popups.push({ x:x, y:y, text:text, col:col, life:0 }); }

/* ---------- food (teacher feeding) ---------- */
var foods = [];
function foodKind(pct){ return pct <= 0 ? 'rotten' : pct < 50 ? 'flakes' : pct < 75 ? 'pellet' : pct < 90 ? 'shrimp' : 'gold'; }
function dropFood(name, e, val){
  var f = fishByName(name);
  var mx = (DATA.max && DATA.max[e]) || 100;
  var fd = { name:name, e:e, val:val, kind:foodKind(val/mx*100), x: f ? clamp(f.x + rnd(-80,80)*SC, 30, W-30) : W/2,
    y:-12, vy:0, age:0, rot:rnd(0,6), eaten:false, section: DATA.section };
  foods.push(fd);
  if (f){ if (f.food && !f.food.eaten) eatFood(f.food, null); f.food = fd; }
  else eatFood(fd, null);
}
function fishByName(name){
  var found = null;
  fishes.forEach(function(f){ if (!found && f.m.name === name) found = f; });
  return found;
}
function eatFood(fd, f){
  if (fd.eaten) return;
  fd.eaten = true;
