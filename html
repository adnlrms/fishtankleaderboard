/* ---------- leaderboard & card ---------- */
function renderBoard(){
  var medal = ['🥇','🥈','🥉'];
  $('board').innerHTML = sortedModels.map(function(m){
    var icons = (m.crown ? '👑' : '') + (m.improved ? '✨' : '') + (m.sick ? '🤒' : '') + (m.scar ? '🩹' : '');
    var dot = m.sick ? 'hsl(85,25%,55%)' : 'hsl(' + m.hue + ',75%,58%)';
    return '<div class="row' + (m.sick ? ' sick' : '') + '" data-key="' + esc(m.key) + '">' +
      '<div class="rank">' + (m.rank <= 3 && m.points > 0 ? medal[m.rank-1] : m.rank) + '</div>' +
      '<div class="dot" style="background:' + dot + '"></div>' +
      '<div class="nm">' + esc(m.name) + ' <small>' + STAGES[m.stage].name + '</small> ' + icons + '</div>' +
