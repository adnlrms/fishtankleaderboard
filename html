  var tip = 'Press F11 (Windows) or Ctrl+Cmd+F (Mac) for full screen';
  if (el.requestFullscreen) el.requestFullscreen().catch(function(){ toast(tip); });
  else toast(tip);
}
function replay(){
  if (playTimer){ stopPlay(); return; }
  if (!DATA || DATA.lastExam < 0) return;
  followLatest = false; viewExam = -1; $('exam').value = -1; recompute();
  $('play').textContent = '⏸ Stop'; $('play').classList.add('on');
  playTimer = setInterval(function(){
    if (viewExam >= DATA.lastExam){ stopPlay(); return; }
    viewExam++; $('exam').value = viewExam; recompute();
  }, 2600);
}
function stopPlay(){
  clearInterval(playTimer); playTimer = null;
  $('play').textContent = '▶ Replay'; $('play').classList.remove('on');
  followLatest = viewExam === DATA.lastExam;
}

var toastT = null;
