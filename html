function submitFeed(inp){
  var i = +inp.getAttribute('data-i'), s = DATA.students[i], e = feedExam;
  if (!s || e < 0) return;
  var st = inp.parentNode.querySelector('.st');
  var raw = inp.value.trim().replace(',', '.');
  var val = raw === '' ? null : Number(raw);
  var mx = DATA.max[e] || 100;
  if (raw !== '' && (!isFinite(val) || val < 0)){ inp.classList.add('err'); st.textContent = '⚠'; toast('Please type a number (or leave it empty if absent).'); return false; }
  if (val !== null && val > mx){ inp.classList.add('err'); st.textContent = '⚠'; toast('That is more than the perfect score (' + fmt(mx) + ').'); return false; }
  inp.classList.remove('err');
  var cur = s.scores[e]; if (cur === undefined) cur = null;
  var pend = inp.getAttribute('data-pending');
  var known = pend !== null ? pend : (inp.hasAttribute('data-last') ? inp.getAttribute('data-last') : String(cur));
  if (String(val) === known) return true;
  inp.setAttribute('data-pending', String(val));
  st.textContent = '⏳';
  if (playTimer) stopPlay();
  followLatest = true;
  var section = DATA.section, exam = DATA.exams[e], name = s.name;
