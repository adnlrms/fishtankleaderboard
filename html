  } else if (fd.kind === 'pellet'){
    var g = c.createRadialGradient(-2*s, -2*s, 1, 0, 0, 8*s); g.addColorStop(0, '#e0a060'); g.addColorStop(1, '#7a4a1c');
    c.fillStyle = g; c.beginPath(); c.arc(0, 0, 7*s, 0, 7); c.fill();
  } else {
    var gold = fd.kind === 'gold';
    if (gold){
      var gg = c.createRadialGradient(0, 0, 2, 0, 0, 22*s); gg.addColorStop(0, 'rgba(255,220,100,.55)'); gg.addColorStop(1, 'rgba(255,220,100,0)');
      c.fillStyle = gg; c.beginPath(); c.arc(0, 0, 22*s, 0, 7); c.fill();
    }
    c.rotate(Math.sin(fd.age*2)*.4);
    c.strokeStyle = gold ? '#ffcc33' : '#ff8fa3'; c.lineCap = 'round'; c.lineWidth = 6*s;
    c.beginPath(); c.arc(0, 0, 8*s, .3, Math.PI*1.45); c.stroke();
    c.strokeStyle = gold ? '#fff0a8' : '#ffd0da'; c.lineWidth = 1.2*s;
    for (var q = 0; q < 4; q++){ var a = .6 + q*.6; c.beginPath(); c.moveTo(Math.cos(a)*5*s, Math.sin(a)*5*s); c.lineTo(Math.cos(a)*11*s, Math.sin(a)*11*s); c.stroke(); }
    c.fillStyle = gold ? '#ffcc33' : '#ff8fa3';
    c.beginPath(); c.moveTo(Math.cos(1.45*Math.PI)*8*s, Math.sin(1.45*Math.PI)*8*s); c.lineTo(-4*s, -13*s); c.lineTo(4*s, -12*s); c.fill();
    if (gold) for (var i = 0; i < 3; i++){ var b = t*3 + i*2.1; drawStar(c, Math.cos(b)*15*s, Math.sin(b)*15*s, 2.5*s, '#fff6c0'); }
  }
