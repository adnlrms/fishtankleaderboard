/* ---------- main render ---------- */
function renderScene(t, dt){
  var c = ctx;
  c.drawImage(layers.bg, 0, 0, W, H);
  if (!rayGrad){
    rayGrad = c.createLinearGradient(0, 0, 0, H*.85);
    rayGrad.addColorStop(0, 'rgba(255,255,255,.13)'); rayGrad.addColorStop(1, 'rgba(255,255,255,0)');
  }
  scene.rays.forEach(function(r){
    var x = r.x*W + Math.sin(t*r.s + r.p)*60*SC;
    c.fillStyle = rayGrad; c.beginPath();
    c.moveTo(x - r.w*.3, 0); c.lineTo(x + r.w*.3, 0);
    c.lineTo(x + r.w + r.sk*W*.15, H*.85); c.lineTo(x - r.w + r.sk*W*.15, H*.85); c.fill();
  });
  c.strokeStyle = 'rgba(255,255,255,.12)'; c.lineWidth = 2;
  for (var j = 0; j < 3; j++){
    c.beginPath();
    for (var x = 0; x <= W; x += 20) c.lineTo(x, 8 + j*9 + Math.sin(x*.02 + t*(1+j*.3) + j)*3);
    c.stroke();
  }
  c.fillStyle = 'rgba(220,240,255,.35)';
  scene.plankton.forEach(function(p){
    var px = (p.x + t*p.s) % W, py = p.y + Math.sin(t*.5 + p.p)*8;
    c.beginPath(); c.arc(px, py, p.r, 0, 7); c.fill();
  });
  scene.weeds.forEach(function(w){ if (!w.front) drawWeed(c, w, t, 1); });
  c.drawImage(layers.sand, 0, 0, W, H);
  var s = SC;
  if (unlocked.has('coral')) drawCoral(c, W*.1, sandY(W*.1) + 6*s, s, t);
  if (unlocked.has('shells')) drawShells(c, W*.37, sandY(W*.37) + 8*s, s, t);
  if (unlocked.has('chest')){
    drawChest(c, W*.58, sandY(W*.58) + 8*s, s, t);
    if (Math.random() < dt*1.2) bubble(W*.58 + rnd(-20,20)*s, sandY(W*.58) - 40*s, 'gold');
  }
  if (unlocked.has('sub')) drawSub(c, W*.84, sandY(W*.84) - 60*s, s, t);
  scene.vents.forEach(function(v){
    v.t -= dt;
    if (v.t <= 0){ bubble(v.x + rnd(-4,4), sandY(v.x), 'vent'); v.t = Math.random() < .3 ? rnd(1.5,4) : rnd(.15,.35); }
  });
}

function drawWeed(c, w, t, alpha){
  var base = sandY(w.x) + 6*SC, seg = 9, px = w.x, py = base;
  c.lineCap = 'round';
  for (var i = 1; i <= seg; i++){
    var nx = w.x + Math.sin(t*.9 + w.ph + i*.45) * i * 1.8 * SC;
    var ny = base - w.h*i/seg;
    c.strokeStyle = 'hsla(' + w.hue + ',55%,' + (26 + i*1.5) + '%,' + alpha + ')';
    c.lineWidth = w.w * (1 - i/seg*.7);
    c.beginPath(); c.moveTo(px, py); c.lineTo(nx, ny); c.stroke();
    px = nx; py = ny;
  }
}

function renderFX(c, t, dt){
  for (var i = bubbles.length - 1; i >= 0; i--){
    var b = bubbles[i];
    b.life += dt; b.y -= b.vy*dt; b.x += Math.sin(b.life*3 + b.ph)*.35;
    if (b.y < -10 || (b.kind === 'sick' && b.life > 3.5)){ bubbles.splice(i,1); continue; }
    c.beginPath(); c.arc(b.x, b.y, b.r, 0, 7);
    if (b.kind === 'sick'){ c.fillStyle = 'rgba(175,220,110,.3)'; c.strokeStyle = 'rgba(205,240,150,.75)'; }
    else if (b.kind === 'gold'){ c.fillStyle = 'rgba(255,220,120,.2)'; c.strokeStyle = 'rgba(255,230,150,.7)'; }
    else { c.fillStyle = 'rgba(200,230,255,.12)'; c.strokeStyle = 'rgba(225,245,255,.6)'; }
    c.lineWidth = 1; c.fill(); c.stroke();
    c.beginPath(); c.arc(b.x - b.r*.35, b.y - b.r*.35, b.r*.25, 0, 7); c.fillStyle = 'rgba(255,255,255,.7)'; c.fill();
  }
  for (i = parts.length - 1; i >= 0; i--){
    var p = parts[i];
    p.life += dt; if (p.life > p.max){ parts.splice(i,1); continue; }
    p.x += p.vx*dt; p.y += p.vy*dt; p.vx *= .97; p.vy *= .97;
    c.globalAlpha = 1 - p.life/p.max;
    if (p.heart){ c.font = Math.round(p.r*3) + 'px sans-serif'; c.textAlign = 'center'; c.textBaseline = 'middle'; c.fillText('💚', p.x, p.y); }
    else drawStar(c, p.x, p.y, p.r, p.col);
    c.globalAlpha = 1;
  }
  for (i = popups.length - 1; i >= 0; i--){
    var u = popups[i];
    u.life += dt; if (u.life > 1.8){ popups.splice(i,1); continue; }
    var fs = Math.round(24*SC + 6);
    c.globalAlpha = 1 - Math.max(0, u.life - 1)/.8;
    c.font = '700 ' + fs + 'px Fredoka, system-ui, sans-serif'; c.textAlign = 'center'; c.textBaseline = 'middle';
    c.lineWidth = 4; c.strokeStyle = 'rgba(0,20,40,.8)';
    c.strokeText(u.text, u.x, u.y - u.life*30*SC); c.fillStyle = u.col; c.fillText(u.text, u.x, u.y - u.life*30*SC);
    c.globalAlpha = 1;
  }
}

var lastT = performance.now();
var cardCtx = $('cardFish').getContext('2d');
var drawOrder = [];
var frameErrors = 0;
function frame(now){
  requestAnimationFrame(frame);           // schedule first, so one bad frame can never freeze the tank
  try { drawFrame(now); frameErrors = 0; }
  catch (err){
    if (ctx.reset) ctx.reset();           // clear any unbalanced save() left by the failed frame
    if (++frameErrors === 1 && window.console) console.error('Aquarium frame error:', err);
    if (frameErrors > 120){ ctx.setTransform(DPR,0,0,DPR,0,0); frameErrors = 0; }
  }
}
function drawFrame(now){
  var dt = Math.min(.05, Math.max(0, (now - lastT)/1000)); lastT = now;
  var t = now/1000;
  ctx.setTransform(DPR,0,0,DPR,0,0); ctx.globalAlpha = 1;
  if (W && H){
    renderScene(t, dt);
    foods.slice().forEach(function(fd){
      fd.age += dt; fd.vy = Math.min(fd.vy + 70*SC*dt, 75*SC); fd.y += fd.vy*dt; fd.x += Math.sin(fd.age*2 + fd.rot)*.4;
      var gy = sandY(fd.x) - 8*SC; if (fd.y > gy) fd.y = gy;
      if (fd.age > 9) eatFood(fd, fishByName(fd.name));
      else drawFood(ctx, fd, t);
    });
    var list = Array.from(fishes.values());
    list.forEach(function(f){ f.update(dt); });
    list.sort(function(a,b){ return b.size - a.size; });
    list.forEach(function(f){ drawFishEntity(ctx, f, t); });
    renderFX(ctx, t, dt);
    scene.weeds.forEach(function(w){ if (w.front) drawWeed(ctx, w, t, .85); });
    ctx.drawImage(layers.vig, 0, 0, W, H);
    drawOrder = list;
  }
  if (cardKey){
    var f = fishes.get(cardKey);
    if (f){
      cardCtx.setTransform(1,0,0,1,0,0); cardCtx.clearRect(0, 0, 260, 172);
      var L = 34 + f.m.g*46;
      cardCtx.setTransform(2,0,0,2,130 + L*.2,96);
      drawFishShape(cardCtx, L, { hue:f.m.hue, stage:f.m.stage, sick:f.m.sick, scar:f.m.scar,
        wag: Math.sin(t*(f.m.sick ? 2.5 : 6))*(f.m.sick ? .12 : .3), fin: Math.sin(t*4) });
      if (f.m.crown) drawCrown(cardCtx, L*.1, -L*.27 - 2, clamp(L*.36, 12, 26), t);
    }
  }
}

/* ---------- interaction ---------- */
function fishAt(px, py){
  for (var i = drawOrder.length - 1; i >= 0; i--){
    var f = drawOrder[i], L = Math.max(f.size, 22*SC);
    var dx = (px - f.x)/(L*.55), dy = (py - f.y)/(L*.4);
    if (dx*dx + dy*dy <= 1) return f;
  }
  return null;
}
