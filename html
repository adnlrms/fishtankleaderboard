}

/* ---------- decorations ---------- */
function drawCoral(c, x, y, s, t){
  c.save(); c.lineCap = 'round';
  function br(x0, y0, a, len, w, d){
    var sw = Math.sin(t*.8 + d + x0*.01)*.05;
    var x1 = x0 + Math.cos(a+sw)*len, y1 = y0 + Math.sin(a+sw)*len;
    c.lineWidth = w; c.beginPath(); c.moveTo(x0,y0); c.lineTo(x1,y1); c.stroke();
    if (d < 3){ br(x1, y1, a-.48, len*.72, w*.72, d+1); br(x1, y1, a+.42, len*.7, w*.72, d+1); }
    else { c.beginPath(); c.arc(x1, y1, w*.9, 0, 7); c.fill(); }
  }
  c.strokeStyle = '#ff7f8f'; c.fillStyle = '#ffb3bd'; br(x, y, -Math.PI/2, 46*s, 11*s, 0);
  c.strokeStyle = '#ff9f5a'; c.fillStyle = '#ffd3a3'; br(x + 42*s, y + 2*s, -Math.PI/2 + .25, 32*s, 8*s, 1);
  c.strokeStyle = '#c779ff'; c.fillStyle = '#e4bfff'; br(x - 36*s, y + 3*s, -Math.PI/2 - .3, 26*s, 7*s, 1);
  c.restore();
}
function drawShells(c, x, y, s, t){
  c.save(); c.translate(x, y - 6*s); c.rotate(.2 + Math.sin(t*.5)*.03);
  c.beginPath();
  for (var i = 0; i < 10; i++){
    var a = -Math.PI/2 + i*Math.PI/5, r = i%2 ? 9*s : 24*s;
    c.lineTo(Math.cos(a)*r, Math.sin(a)*r);
  }
  c.closePath(); c.fillStyle = '#ff8c42'; c.fill(); c.strokeStyle = '#d4602a'; c.lineWidth = 2*s; c.stroke();
  c.fillStyle = '#ffd0a8';
  for (i = 0; i < 5; i++){ var a2 = -Math.PI/2 + i*2*Math.PI/5; c.beginPath(); c.arc(Math.cos(a2)*12*s, Math.sin(a2)*12*s, 1.8*s, 0, 7); c.fill(); }
  c.restore();
  c.save(); c.translate(x + 50*s, y - 2*s);
  c.beginPath(); c.moveTo(0, 0); c.arc(0, 0, 20*s, Math.PI, 0); c.closePath();
  c.fillStyle = '#ffe6ef'; c.fill(); c.strokeStyle = '#e7a6bd'; c.lineWidth = 1.5*s; c.stroke();
  for (i = 1; i < 6; i++){ var a3 = Math.PI + i*Math.PI/6; c.beginPath(); c.moveTo(0,0); c.lineTo(Math.cos(a3)*20*s, Math.sin(a3)*20*s); c.stroke(); }
  c.restore();
}
function drawChest(c, x, y, s, t){
  c.save(); c.translate(x, y);
  var g = c.createRadialGradient(0, -30*s, 4*s, 0, -30*s, 70*s);
  g.addColorStop(0, 'rgba(255,220,100,' + (.35 + Math.sin(t*2)*.1) + ')'); g.addColorStop(1, 'rgba(255,220,100,0)');
  c.fillStyle = g; c.beginPath(); c.arc(0, -30*s, 70*s, 0, 7); c.fill();
  rr(c, -36*s, -34*s, 72*s, 34*s, 4*s); c.fillStyle = '#8a5a2b'; c.fill();
  c.fillStyle = '#6d4420'; c.fillRect(-36*s, -22*s, 72*s, 4*s);
  c.fillStyle = '#e8b830'; c.fillRect(-36*s, -34*s, 6*s, 34*s); c.fillRect(30*s, -34*s, 6*s, 34*s);
  c.fillStyle = '#ffd84a';
  for (var i = 0; i < 7; i++){ c.beginPath(); c.ellipse(-24*s + i*8*s, -35*s - (i%2)*4*s, 6*s, 3.5*s, 0, 0, 7); c.fill(); }
  c.save(); c.translate(-36*s, -34*s); c.rotate(-.55);
