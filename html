        busy(ps, true, 'Saving…');
        api('changePin', teacher.pin, a).then(function(){ teacher.pin = a; b.querySelector('#pErr').textContent = ''; busy(ps, false, 'PIN changed ✓'); })
          .catch(function(e){ if (/WRONG_PIN|NO_PIN/.test(String(e && e.message))) return handleTeacherError(e); b.querySelector('#pErr').textContent = errText(e); busy(ps, false, 'Change PIN'); });
      };
    });
});

