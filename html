function renderChart(m){
  var svg = $('chart'), n = viewExam + 1;
  if (n <= 0){ svg.innerHTML = '<text x="210" y="80" fill="#93bfdf" font-size="14" text-anchor="middle">No exams yet</text>'; return; }
  var scores = DATA.students[m.i].scores, Wc = 420, Hc = 160, top = 22, bottom = 30, pad = 10;
  var plotH = Hc - top - bottom, slot = (Wc - pad*2)/n, bw = Math.min(38, slot*.66);
  var passY = top + plotH*(1 - CFG.passingPercent/100);
  var out = '<line x1="' + pad + '" x2="' + (Wc-pad) + '" y1="' + passY + '" y2="' + passY + '" stroke="#ffd34d" stroke-dasharray="4 4" opacity=".55"/>' +
    '<text x="' + (Wc-pad) + '" y="' + (passY-4) + '" fill="#ffd34d" font-size="10" text-anchor="end" opacity=".8">passing</text>';
  for (var e = 0; e < n; e++){
    var sc = scores[e], mx = (DATA.max && DATA.max[e]) || 100, cx = pad + slot*(e+.5);
    var lab = String(DATA.exams[e]); if (lab.length > 9) lab = lab.slice(0,8) + '…';
    out += '<text x="' + cx + '" y="' + (Hc-10) + '" fill="#93bfdf" font-size="10.5" text-anchor="middle">' + esc(lab) + '</text>';
    if (sc === null || sc === undefined){
      out += '<text x="' + cx + '" y="' + (top+plotH-6) + '" fill="#6f8fa8" font-size="12" text-anchor="middle">absent</text>';
      continue;
    }
    var pct = clamp(sc/mx*100, 0, 100), h = Math.max(3, plotH*pct/100), y = top + plotH - h;
    var col = sc === 0 ? '#ff6b6b' : pct >= CFG.passingPercent ? '#4fe0c0' : '#ffb35c';
    out += '<rect x="' + (cx-bw/2) + '" y="' + y + '" width="' + bw + '" height="' + h + '" rx="5" fill="' + col + '"/>' +
      '<text x="' + cx + '" y="' + (y-5) + '" fill="#ecf7ff" font-size="12" font-weight="600" text-anchor="middle">' + fmt(sc) + '</text>';
  }
  svg.innerHTML = out;
}

function syncFish(){
